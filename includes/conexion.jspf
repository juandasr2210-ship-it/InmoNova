<%-- includes/conexion.jspf : UNICA conexion JDBC centralizada. No repetir en cada JSP. --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.sql.*" %>
<%
    String DB_URL  = application.getInitParameter("db.url");
    String DB_USER = application.getInitParameter("db.user");
    String DB_PASS = application.getInitParameter("db.pass");
    String DB_DRIVER = application.getInitParameter("db.driver");
    if (DB_URL == null)  DB_URL  = "jdbc:mysql://localhost:3306/inmonova?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8";
    if (DB_USER == null) DB_USER = "root";
    if (DB_PASS == null) DB_PASS = "";
    if (DB_DRIVER == null) DB_DRIVER = "com.mysql.cj.jdbc.Driver";
    try { Class.forName(DB_DRIVER); } catch (Exception e) { /* driver va en C:/xampp/tomcat/lib */ }
%>
<%!
    Connection abrirConexion(ServletContext app) throws Exception {
        String url = app.getInitParameter("db.url");
        String usr = app.getInitParameter("db.user");
        String pwd = app.getInitParameter("db.pass");
        String drv = app.getInitParameter("db.driver");
        if (url == null) url = "jdbc:mysql://localhost:3306/inmonova?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8";
        if (usr == null) usr = "root";
        if (pwd == null) pwd = "";
        if (drv == null) drv = "com.mysql.cj.jdbc.Driver";
        Class.forName(drv);
        return DriverManager.getConnection(url, usr, pwd);
    }
%>
